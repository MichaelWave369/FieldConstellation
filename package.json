{
  "name": "field-constellation",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive 3D atlas of MichaelWave369’s public GitHub repositories.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "refresh": "node scripts/refresh-public.mjs",
    "preview": "node scripts/serve.mjs",
    "acceptance:browser": "node scripts/browser-acceptance.mjs",
    "destinations:check": "node scripts/check-deployments.mjs",
    "atlas:refresh": "node scripts/refresh-atlas.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "build:domain": "npm run build && node scripts/prepare-domain.mjs",
    "domain:verify": "node scripts/verify-domain.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
